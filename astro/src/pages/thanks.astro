---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import content from "../data/content.json";
const t = content.en;
const email = content.email;
---
<BaseLayout title="Thank you | Diler Services" desc="Thanks, we got your message." lang="en" path="/thanks/" noindex={true}>
  <Header t={t} email={email} />
  <main>
    <style is:inline set:html={`.ds-thanks{background:#f4f6f5;min-height:60vh;display:flex;align-items:center}
.ds-thanks-card{max-width:640px;margin:0 auto;padding:48px 32px;background:#fff;border:1px solid #dfe6e5;border-radius:12px;text-align:center}
.ds-thanks-ico{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:12px;background:#C8F169;color:#144443;margin-bottom:20px}
.ds-thanks-ico svg{width:26px;height:26px}
.ds-thanks h1{font-size:40px;color:#144443;margin:0 0 16px;line-height:1.15}
.ds-thanks p{color:#3d4f4e;font-size:17px;margin:0 0 12px}
.ds-thanks-mail a{color:#144443;font-weight:600;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
.ds-thanks .ds-thanks-btn{display:inline-block;margin-top:20px;padding:14px 32px;text-align:center;background:#C8F169;color:#144443;font-weight:600;border-radius:6px;text-decoration:none}
.ds-thanks .ds-thanks-btn:hover{background:#b7e24f}
@media(max-width:575px){.ds-thanks h1{font-size:30px}.ds-thanks-card{padding:36px 20px}}`}></style>
    <section class="ds-thanks section-padding">
      <div class="ds-thanks-card">
        <span class="ds-thanks-ico"><Icon name="check" /></span>
        <h1>Thanks, we got your message</h1>
        <p>We will reply to you by email.</p>
        <p class="ds-thanks-mail">Need to add something? Write to <a href="mailto:info@dilerservices.com">info@dilerservices.com</a></p>
        <a class="ds-thanks-btn" href="/">Back to home</a>
      </div>
    </section>
  </main>
  <Footer t={t} email={email} />
</BaseLayout>
