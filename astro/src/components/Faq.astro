---
import Icon from "./Icon.astro";
const { t } = Astro.props;
---
<section class="faq-section fix section-padding section-bg" id="faq">
  <div class="auto-container">
    <div class="row g-4 justify-content-between align-items-start">
      <div class="col-xl-5 col-lg-6">
        <div class="faq-left-items-1">
          <div class="sec-title mb-0">
            <div class="h6 sub-title reveal"> {t.fq_sub}</div>
            <h2 class="reveal">{t.fq_h2}</h2>
          </div>
        </div>
      </div>
      <div class="col-xl-6 col-lg-6">
        <div class="faq-content-1">
          <ul class="accordion-box">
            {t.faqs.map(([q, a], i) => (
              <li class:list={["accordion block reveal", { "active-block": i === 0 }]}>
                <button type="button" class:list={["acc-btn", { active: i === 0 }]} aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
                  {q} <span class="icon"><Icon name="plus" /></span>
                </button>
                <div class:list={["acc-content", { current: i === 0 }]} id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
                  <div class="content"><div class="text">{a}</div></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
