---
import Icon from "./Icon.astro";
const { t, base = "/" } = Astro.props;
const groups = [["llc", t.pr_tab1, t.llc, false], ["yearly", t.pr_tab2, t.yearly, true]];
---
<section class="pricing-section fix section-padding" id="pricing">
  <div class="auto-container">
    <div class="sec-title text-center">
      <div class="h6 sub-title reveal"> {t.pr_sub}</div>
      <h2 class="reveal"><Fragment set:html={t.pr_h2} /></h2>
    </div>
    {groups.map(([id, label, plans, yearly]) => (
      <div class="ds-pgroup" id={id}>
        <h3 class="ds-pgroup-h reveal">{label}</h3>
        <div class="row">
          {plans.map((p) => (
            <div class="col-lg-4 col-md-6 reveal">
              <div class:list={["ds-pcard", { "is-rec": p.rec }]}>
                {p.rec && <span class="ds-rec">{t.recommended}</span>}
                <h4 class="ds-pname">{p.name}</h4>
                <div class="ds-price"><span class="ds-amt">{p.fee}</span><span class="ds-unit">{t.svc_fee}{yearly ? ` ${t.per_year}` : ""}</span></div>
                {p.monthly && <div class="ds-pline">{p.monthly}</div>}
                {p.state
                  ? <div class="ds-pline ds-state"><strong>+ {p.state} {t.state_fee}</strong><span>{p.sdet}</span></div>
                  : <div class="ds-pline ds-state"><span>{p.sdet}</span></div>}
                <p class="ds-best">{p.summary}</p>
                <ul class="ds-plist">
                  {p.inc.map((x) => (
                    x.startsWith("Everything in") || x.startsWith("Todo") || x.startsWith("Tudo")
                      ? <li class="ds-plus">{x}</li>
                      : <li><span class="ds-pcheck"><Icon name="check" /></span><span>{x}</span></li>
                  ))}
                </ul>
                <a class="ds-pbtn" href={`${base}#contact`}>{t.choose} {p.name}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
    <p class="pricing-note reveal">{t.pr_note}</p>
  </div>
</section>
