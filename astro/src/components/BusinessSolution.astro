---
import { Picture } from 'astro:assets';
import img_home_1_business_image_1 from '../assets/home-1/business-image-1.jpg';
import img_home_1_business_image_2 from '../assets/home-1/business-image-2.jpg';
const { t } = Astro.props;
---
<section class="business-solution-section">
<div class="container pt-0 pb-0">
<div class="row g-0">
<div class="col-xl-4 col-lg-4 reveal">
<div class="feature-left-content-1">
<h2 class="text-anim">{t.bs_h2}</h2>
<div class="client-image"><span class="lang-chip">EN</span><span class="lang-chip">ES</span><span class="lang-chip">PT</span></div>
<div class="h4">{t.bs_lang_title}</div>
<div class="star"><span>{t.bs_lang_sub}</span></div>
</div>
</div>
<div class="col-xl-8 col-lg-8">
<div class="row g-4">
<div class="col-lg-6 col-md-6 reveal">
<div class="feature-business-solution-items-1">
<div class="business-image">
<Picture src={img_home_1_business_image_1} formats={["avif","webp"]} alt="" loading="lazy" />

</div>
<div class="content">
<div class="icon">
<svg fill="none" height="29" viewBox="0 0 37 29" width="37" xmlns="http://www.w3.org/2000/svg">
<path d="M1.46875 14.4101V8.05758C1.46875 6.8881 2.4168 5.94008 3.58625 5.94008H12.0563M1.46875 14.4101V24.9976C1.46875 26.1671 2.4168 27.1151 3.58625 27.1151H33.2313C34.4007 27.1151 35.3488 26.1671 35.3488 24.9976V14.4101M1.46875 14.4101L16.2913 16.5276H20.5263L35.3488 14.4101M12.0563 5.94008V3.82258C12.0563 2.65313 13.0043 1.70508 14.1738 1.70508H22.6438C23.8132 1.70508 24.7613 2.65313 24.7613 3.82258V5.94008M12.0563 5.94008H24.7613M35.3488 14.4101V8.05758C35.3488 6.8881 34.4007 5.94008 33.2313 5.94008H24.7613M16.2913 19.7038H20.5263" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<h3>{t.bs1_h}</h3>
<p>{t.bs1_p}</p>
</div>
</div>
</div>
<div class="col-lg-6 col-md-6 reveal">
<div class="feature-business-solution-items-2">
<div class="content">
<h3>{t.bs2_h}</h3>
<p>{t.bs2_p}</p>
<div class="icon">
<svg fill="none" height="40" viewBox="0 0 40 40" width="40" xmlns="http://www.w3.org/2000/svg">
