---
const { t } = Astro.props;
---
<section class="ds-strip">
<div class="auto-container">
<h2 class="ds-strip-title reveal">{t.bs_h2}</h2>
<div class="ds-strip-grid">
<article class="ds-strip-card reveal">
<span class="ds-strip-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="m9 15 2 2 4-4"/></svg></span>
<h3>{t.bs1_h}</h3>
<p>{t.bs1_p}</p>
</article>
<article class="ds-strip-card reveal">
<span class="ds-strip-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 4l9 5.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-6h6v6"/></svg></span>
<h3>{t.bs2_h}</h3>
<p>{t.bs2_p}</p>
</article>
<article class="ds-strip-card reveal">
<span class="ds-strip-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg></span>
<h3>{t.bs_lang_title}</h3>
<p>{t.bs_lang_sub}</p>
<div class="ds-strip-tags"><span>EN</span><span>ES</span><span>PT</span></div>
</article>
</div>
</div>
</section>
