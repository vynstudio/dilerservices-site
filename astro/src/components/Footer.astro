---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";
const { t, email, lang = "en", base = "/" } = Astro.props;
const nav = [[t.nav_home, base], [t.nav_services, `${base}#services`], [t.nav_pricing, `${base}#pricing`], [t.nav_faq, `${base}#faq`], [t.nav_contact, `${base}#contact`]];
---
<footer class="footer-section-1 fix footer-bg">
  <div class="auto-container">
    <div class="footer-newsletter-wrapper">
      <div class="footer-newsletter-left reveal">
        <span class="ds-ico-sq"><Icon name="envelope" /></span>
        <h2 class="h3 text-white font-weight-700 font-size-28"><Fragment set:html={t.ft_news_h3} /></h2>
      </div>
      <a class="footer-mail reveal" href={`mailto:${email}`}>
        <span class="form-clt"><span class="footer-mail-text">{email}</span>
          <span class="arrow-icon"><Icon name="arrow" /></span>
        </span>
      </a>
    </div>
    <div class="footer-widget-wrapper">
      <div class="row justify-content-between">
        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 reveal">
          <div class="footer-widget-items mt-30">
            <div class="widget-title mb-25"><a class="footer-logo" href={base}><Logo dark /></a></div>
            <div class="footer-content"><p>{t.ft_about}</p><LangSwitch lang={lang} cls="social-icon lang-switch" /></div>
          </div>
        </div>
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 reveal">
          <div class="footer-widget-items mt-30">
            <div class="widget-title mb-25"><h3 class="font-size-24 text-white font-weight-500">{t.ft_company}</h3></div>
            <ul class="user-links">{nav.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
          </div>
        </div>
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 reveal">
          <div class="footer-widget-items mt-30">
            <div class="widget-title mb-25"><h3 class="font-size-24 text-white font-weight-500">{t.ft_services}</h3></div>
            <ul class="user-links">{t.mq.slice(0, 4).map((x) => <li><a href={`${base}#pricing`}>{x}</a></li>)}</ul>
          </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 reveal">
          <div class="footer-widget-items mt-30">
            <div class="widget-title mb-25"><h3 class="font-size-24 text-white font-weight-500">{t.ft_contact}</h3></div>
            <ul class="contact-list"><li><Icon name="envelope" class="ds-foot-ico" /><p><a href={`mailto:${email}`}>{email}</a></p></li></ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom"><div class="auto-container"><p>{t.ft_copy}</p></div></div>
</footer>
