---
import { Picture } from 'astro:assets';
import img_home_1_project_project_01 from '../assets/home-1/project/project-01.jpg';
import img_home_1_project_project_02 from '../assets/home-1/project/project-02.jpg';
import img_home_1_project_project_03 from '../assets/home-1/project/project-03.jpg';
const { t } = Astro.props;
---
<section class="project-section fix section-padding">


<div class="auto-container">
<div class="sec-title">
<div class="row g-4 justify-content-between align-items-end">
<div class="col-lg-7">
<div class="h6 sub-title reveal"> {t.hw_sub} </div>
<h2 class="reveal"><Fragment set:html={t.hw_h2} /></h2>
</div>
</div>
</div>
<div class="project-wrapper">
<div class="project-slider fix">
<div class="project-track">
<div class="project-slide">
<div class="project-card-items">
<div class="project-image">
<Picture src={img_home_1_project_project_01} formats={["avif","webp"]} alt="" loading="lazy" />

<span class="number">01</span>
</div>
<div class="project-content">

<div class="content">
<h3><a href="/#contact">{t.hw1_h}</a></h3>
<p>{t.hw1_p}</p>
</div>
<a aria-label={t.hw1_h} class="icon" href="/#contact">
<svg fill="none" height="23" viewBox="0 0 23 23" width="23" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient gradientUnits="userSpaceOnUse" id="paint0_linear_1_17562" x1="21.213" x2="1.32146" y1="0.34721" y2="21.6783">
<stop offset="0" stop-color="#C8F169"></stop>
