---
import { Picture } from 'astro:assets';
import s1 from '../assets/step-1.jpg';
import s2 from '../assets/step-2.jpg';
import s3 from '../assets/step-3.jpg';
import Icon from './Icon.astro';
const { t } = Astro.props;
const steps = [[s1, "Person working on a laptop in an office", t.hw1_h, t.hw1_p], [s2, "Two people signing a document at a desk", t.hw2_h, t.hw2_p], [s3, "Business owner smiling at her desk", t.hw3_h, t.hw3_p]];
---
<section class="ds-steps section-padding">
<div class="auto-container">
<div class="h6 sub-title reveal">{t.hw_sub}</div>
<h2 class="reveal"><Fragment set:html={t.hw_h2} /></h2>
<div class="ds-steps-grid">{steps.map(([img, alt, h, p], i) => (
<article class="ds-step reveal">
<div class="ds-photo ds-step-photo"><Picture src={img} formats={["avif","webp"]} widths={[400,640,800]} sizes="(max-width: 991px) 100vw, 400px" alt={alt} loading="lazy" /></div>
<div class="ds-step-body">
<span class="ds-step-n">Step 0{i + 1}</span>
<h3>{h}</h3>
<p>{p}</p>
<a class="ds-step-btn" href="/#contact" aria-label={h}><Icon name="arrow" /></a>
</div>
</article>))}</div>
</div>
</section>
