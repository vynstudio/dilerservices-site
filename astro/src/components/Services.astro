---
import Icon from './Icon.astro';
const { t } = Astro.props;
const items = [["file", t.sv1_h, t.sv1_p], ["home", t.sv2_h, t.sv2_p], ["hash", t.sv3_h, t.sv3_p], ["calendar", t.sv4_h, t.sv4_p]];
---
<section class="ds-services section-padding" id="services">
<div class="auto-container">
<div class="h6 sub-title reveal">{t.sv_sub}</div>
<h2 class="reveal">{t.sv_h2}</h2>
<div class="ds-services-grid">{items.map(([ic, h, p]) => (
<a class="ds-svc reveal" href="/#pricing">
<span class="ds-ico-sq"><Icon name={ic} /></span>
<h3>{h}</h3>
<p>{p}</p>
<span class="ds-svc-more"><Icon name="arrow" /></span>
</a>))}</div>
</div>
</section>
