---
import { Picture } from 'astro:assets';
import aboutImg from '../assets/home-1/about/about-image.jpg';
import Icon from './Icon.astro';
const { t } = Astro.props;
const list = [t.ab_l1, t.ab_l2, t.ab_l3, t.ab_l4];
---
<section class="ds-about section-padding" id="about">
<div class="auto-container">
<div class="ds-about-grid">
<div class="ds-photo reveal">
<Picture src={aboutImg} formats={["avif","webp"]} widths={[480,720,960]} sizes="(max-width: 991px) 100vw, 560px" alt="Team reviewing documents at a laptop" loading="lazy" />
</div>
<div class="ds-about-copy">
<div class="h6 sub-title reveal">{t.ab_sub}</div>
<h2 class="reveal">{t.ab_h2}</h2>
<p class="ds-about-lead reveal"><span class="ds-ico-sq"><Icon name="file" /></span>{t.ab_icon_p}</p>
<p class="ds-about-text reveal">{t.ab_text}</p>
<ul class="ds-check reveal">{list.map((x) => <li><img alt="" src="/images/home-1/about/check.svg" width="22" height="22" />{x}</li>)}</ul>
</div>
</div>
</div>
</section>
