---

const { t } = Astro.props;
---
<section class="counter-section section-padding pt-0">
<div class="auto-container">
<div class="counter-wrapper">
<div class="counter-box-1 reveal">
<div class="count-box">
<div class="h2">$<span class="count-text">99</span></div>
<p>{t.c1}</p>
</div>
</div>
<div class="counter-box-1 reveal">
<div class="count-box">
<div class="h2">$<span class="count-text">125</span></div>
<p>{t.c2}</p>
</div>
</div>
<div class="counter-box-1 reveal">
<div class="count-box">
<div class="h2">$<span class="count-text">169</span></div>
<p>{t.c3}</p>
</div>
</div>
<div class="counter-box-1 reveal">
<div class="count-box">
<div class="h2"><span class="count-text">1</span></div>
<p>{t.c4}</p>
</div>
</div>
</div>
</div>
</section>
