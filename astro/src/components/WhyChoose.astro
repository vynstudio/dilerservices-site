---
import { Picture } from 'astro:assets';
import img_home_1_choose_us_choose_us from '../assets/home-1/choose-us/choose-us.jpg';
const { t } = Astro.props;
---
<section class="why-choose-section fix section-bg">
<div class="auto-container">
<div class="why-choose-us-wrapper">
<div class="row g-4 align-items-center">
<div class="col-xl-5 col-lg-6">
<div class="why-choose-us-image-1">
<Picture src={img_home_1_choose_us_choose_us} formats={["avif","webp"]} alt="" class="reveal" loading="lazy" />
</div>
</div>
<div class="col-xl-7 col-lg-6">
<div class="why-choose-us-content-1">
<div class="sec-title mb-0">
<div class="h6 sub-title"> {t.wc_sub} </div>
<h2 class="reveal">{t.wc_h2}</h2>
</div>
<ul class="nav">
<li class="nav-item reveal">
<a class="nav-link active" data-tab="#language" href="#language">{t.wc_tabs[1]}</a>
</li>
<li class="nav-item reveal">
<a class="nav-link" data-tab="#direct" href="#direct">{t.wc_tabs[2]}</a>
</li>
<li class="nav-item reveal">
<a class="nav-link" data-tab="#reminders" href="#reminders">{t.wc_tabs[3]}</a>
</li>
</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="language">
<div class="why-choose-list">
<h3>{t.bs_lang_title}</h3>
<p>{t.wc_p[1]}</p>
</div>
<div class="why-choose-list-items">
<ul class="why-list">
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[1][0]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[1][1]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[1][2]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_badge} </li>
</ul>
</div>
</div>
<div class="tab-pane fade" id="direct">
<div class="why-choose-list">
<h3>{t.ab_l2}</h3>
<p>{t.wc_p[2]}</p>
</div>
<div class="why-choose-list-items">
<ul class="why-list">
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[2][0]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[2][1]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[2][2]} </li>
</ul>
</div>
</div>
<div class="tab-pane fade" id="reminders">
<div class="why-choose-list">
<h3>{t.wc_h3[3]}</h3>
<p>{t.wc_p[3]}</p>
</div>
<div class="why-choose-list-items">
<ul class="why-list">
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[3][0]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[3][1]} </li>
<li>
<span class="icon">
<img alt="" src="/images/home-1/about/check.svg"/>
</span> {t.wc_list[3][2]} </li>
</ul>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</section>
