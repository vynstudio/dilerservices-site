---
import { Picture } from 'astro:assets';
// Placeholder Envato photo (Finclix template license); swap for new Envato photo later
import contactPhoto from '../assets/home-1/project/project-02.jpg';
const { t } = Astro.props;
---
<section class="ds-contact" id="contact">
<div class="auto-container">
<div class="ds-contact-grid">
<div class="ds-contact-info">
<div class="h6 sub-title">{t.ct_sub}</div>
<h2>{t.ct_h2}</h2>
<p class="ds-contact-lead">Describe the service you need, and Diler Services will respond with a checklist.</p>
<ul class="ds-contact-facts">
<li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href="mailto:info@dilerservices.com">info@dilerservices.com</a></li>
<li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg><span>Services in English, Spanish and Portuguese</span></li>
<li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17h.01"/></svg><a href="#faq">Read the FAQ</a></li>
</ul>
<div class="ds-contact-photo"><Picture src={contactPhoto} formats={["avif","webp"]} widths={[400,640,900]} sizes="(max-width: 991px) 100vw, 560px" alt="" loading="lazy" /></div>
</div>
<div class="ds-contact-card">
<form action="/thanks/" data-netlify="true" method="POST" name="contact" netlify-honeypot="bot-field"><input name="form-name" type="hidden" value="contact"/><input name="language" type="hidden" value="en"/><p hidden=""><label>Do not fill this out <input name="bot-field"/></label></p>
<div class="ds-field"><label for="name">Full name*</label><input autocomplete="name" id="name" name="name" required="" type="text"/></div>
<div class="ds-field"><label for="email">Email*</label><input autocomplete="email" id="email" name="email" required="" type="email"/></div>
<div class="ds-field"><label for="business">Business name</label><input autocomplete="organization" id="business" name="business" type="text"/></div>
<div class="ds-field"><label for="message">What do you need?</label><textarea id="message" name="message" rows="5" aria-describedby="msg-note"></textarea><small id="msg-note">Please do not send an SSN or ITIN.</small></div>
<button class="ds-contact-btn" type="submit">{t.f_btn}</button>
</form>
</div>
</div>
</div>
</section>
